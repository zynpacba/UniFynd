{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "rootDir": "./ts",
        "outDir": "./js",
        "strict": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "ts/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}